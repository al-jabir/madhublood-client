VITE_API_URL=/api/v1
# Vite-only development proxy target; never added to the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:5000
# Optional browser-test configuration (not exposed to the app bundle):
# E2E_BASE_URL=http://127.0.0.1:5173
# E2E_ACCOUNTS_FILE=absolute-path-to-backend-generated-test-fixture.json
# PLAYWRIGHT_BROWSER=msedge

# Production frontend: https://madhublood.vercel.app
# Optional production override (no Vercel env needed by default): VITE_API_URL=https://madhublood-server.onrender.com/api/v1
# See .env.production.example; keep /api/v1 above for the local Vite proxy.
